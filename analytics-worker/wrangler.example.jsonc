{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oehnps-blog-analytics",
  "main": "src/index.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "RETENTION_DAYS": "395" },
  "triggers": { "crons": ["17 18 * * *"] },
  "observability": { "enabled": false },
  "d1_databases": []
  // Copy to ignored wrangler.jsonc for deployment. Configure account_id,
  // DB binding, RATE_LIMITER binding, the two custom domains, ACCESS_TEAM_DOMAIN,
  // ACCESS_AUD, ADMIN_EMAIL and original COLLECTION_STARTED_AT privately.
  // All report/static requests fail closed until authentication is configured.
}
